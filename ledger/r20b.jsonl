on"]},"clarify":null,"max_wave":2,"valid":true,"refusals":[],"digest":{"chars":0,"truncated":false,"sha":"e3b0c44298fc"},"ladder":{"key":"quick-flow-brownfield","steps_to_seal":["technical_spec","dev_plan","capability","implementation"],"must_produce":["technical_spec","dev_plan","capability","implementation"]},"records":{"outcome":"move","artifacts":["technical_spec"],"why":"blocking rungs missing in planning","optional":["stories"],"category":"agree"},"master_session":"74964159-0c95-46a0-825a-0e5b302c180b"}}
